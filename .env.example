APP_NAME="Новости МосПолитеха"
APP_ENV=local
APP_KEY=
# Для локальной разработки поставьте true — тогда видно стек ошибок.
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Moscow

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Широковещание (лабораторная работа №11): событие уходит в Pusher,
# браузер получает его по WebSocket через Laravel Echo.
BROADCAST_CONNECTION=pusher

# Вариант 1 — облако Pusher (https://dashboard.pusher.com):
#   PUSHER_APP_ID, PUSHER_APP_KEY, PUSHER_APP_SECRET берутся в кабинете,
#   PUSHER_APP_CLUSTER=eu, PUSHER_HOST и PUSHER_PORT не задаются,
#   PUSHER_SCHEME=https.
#
# Вариант 2 — локальный сервер вещания (php artisan reverb:start):
#   ключи любые, host/port/scheme указывают на локальный сервер.
PUSHER_APP_ID=blog-mospolytech
PUSHER_APP_KEY=blog-mospolytech-key
PUSHER_APP_SECRET=blog-mospolytech-secret
PUSHER_APP_CLUSTER=eu
PUSHER_HOST=127.0.0.1
PUSHER_PORT=8080
PUSHER_SCHEME=http

# Те же ключи читает локальный сервер вещания
REVERB_APP_ID="${PUSHER_APP_ID}"
REVERB_APP_KEY="${PUSHER_APP_KEY}"
REVERB_APP_SECRET="${PUSHER_APP_SECRET}"
REVERB_HOST="${PUSHER_HOST}"
REVERB_PORT="${PUSHER_PORT}"
REVERB_SCHEME="${PUSHER_SCHEME}"

# Подставляются Vite в JS-бандл
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

FILESYSTEM_DISK=local
# Очередь задач (лабораторная работа №10): задания лежат в таблице jobs,
# обрабатываются командой php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Почта (лабораторная работа №8) ---
# Отправка через SMTP mail.ru. Пароль — «пароль для доверенных приложений»
# из настроек ящика (Пароли для внешних приложений), обычный пароль не подойдёт.
# MAIL_FROM_ADDRESS лучше сделать равным MAIL_USERNAME, иначе mail.ru
# отклонит письмо как отправленное от чужого адреса.
MAIL_MAILER=log
MAIL_HOST=smtp.mail.ru
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="test@mospolytech.ru"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

